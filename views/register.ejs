<body>
    <h1 class="main-title">Register</h1>
    <form method="POST" action="/registered" class="form-container">
        <label for="first_name">First Name:</label>
        <input id="first_name" type="text" required name="first_name" value="<%= formData && formData.first_name ? formData.first_name : '' %>"/>
        
        <label for="last_name">Last Name:</label>
        <input id="last_name" type="text" required name="last_name" value="<%= formData && formData.last_name ? formData.last_name : '' %>"/>
        
        <label for="email">Email:</label>
        <input id="email" type="email" required name="email" value="<%= formData && formData.email ? formData.email : '' %>"/>
        
        <input type="submit" value="OK" class="submit-btn"/>
    </form>
    <% if (errorMessage) { %>
        <div class="alert-box error">
            <%= errorMessage %>
        </div>
    <% } %>
</body>